              "paths": {"dataset": "benchmarks/verified_benchmarks/data/rmcbench.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "RMCBench", "--dimension-label": "恶意代码请求抵御评测", "--benchmark-url": "https://github.com/qing-yuan233/RMCBench", "--max-cases": 20}}
