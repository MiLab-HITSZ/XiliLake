              "paths": {"dataset": "downloads/datasets/huggingface/JailbreakBench__JBB-Behaviors/data/harmful-behaviors.csv", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "JBBBehaviours", "--dimension-label": "综合有害请求抵御评测", "--benchmark-url": "https://huggingface.co/datasets/JailbreakBench/JBB-Behaviors", "--max-cases": 20}}
            },
            {
              "option_key": "harmbench_behaviors",
              "name": "HarmBench",
              "url": "https://github.com/centerforaisafety/HarmBench",
              "language": "English",
              "scale": "text test behaviors",
              "evaluation": "Baseline refusal proxy",
              "intro": "HarmBench 是自动红队框架，但本系统当前只接入行为集合，没有运行攻击方法。该入口因此明确标为有害行为基线拒答，不宣称测得攻击成功率。",
              "paths": {"dataset": "downloads/datasets/github_repos/centerforaisafety__HarmBench/data/behavior_datasets/harmbench_behaviors_text_test.csv", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "HarmBench", "--dimension-label": "综合有害请求抵御评测", "--benchmark-url": "https://github.com/centerforaisafety/HarmBench", "--max-cases": 20}}
            },
            {
              "option_key": "rules_confidentiality",
