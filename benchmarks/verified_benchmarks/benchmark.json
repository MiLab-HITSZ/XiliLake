              "scale": "101 multi-turn dialogues",
              "evaluation": "Refusal proxy",
              "intro": "CHiSafetyBench 当前只接入官方 101 条带完整历史的多轮风险对话，完整拼接系统消息、历史用户轮次、历史助手回复和末轮风险请求；不混入无历史单轮问题。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/chisafetybench.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "CHiSafetyBench", "--dimension-label": "多轮有害请求抵御评测", "--benchmark-url": "https://github.com/UnicomAI/UnicomBenchmark/tree/main/CHiSafetyBench", "--max-cases": 20}}
