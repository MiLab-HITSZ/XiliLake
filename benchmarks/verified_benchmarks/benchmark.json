{
  "id": "verified_benchmarks",
  "label": "原文核验评测入口",
  "benchmark_name": "Source-verified Benchmarks",
  "description": "从论文与官方仓库的指定评测分片整理出的可复现入口，避免通用目录扫描选中错误文件。",
  "source_type": "custom_curated",
  "enabled": true,
  "paths": {"results": "result"},
  "execution": {
    "adapter": "python_cli",
    "script": "evaluate_generic_benchmark.py",
    "default_tasks": ["qa"],
    "supported_tasks": ["qa", "mc"],
    "supports_real_eval": true,
    "args": {
      "dataset": "--dataset",
      "output_dir": "--output-dir",
      "models": "--models",
      "tasks": "--tasks",
      "parallel": "--parallel",
      "retry": "--retry",
      "timeout_s": "--timeout-s",
      "progress_file": "--progress-file",
      "categories": "--categories",
      "dimensions": "--dimensions"
    }
  },
  "display": {
    "mode": "generic_text_qa",
    "sections": ["selection_detail", "progress", "summary", "metrics"],
    "case_view": "text_sample"
  },
  "metrics": [
    {"key": "accuracy", "label": "准确率", "format": "percent"},
    {"key": "response_rate", "label": "响应率", "format": "percent"},
    {"key": "avg_latency_ms", "label": "平均延迟 ms", "format": "number"},
    {"key": "n_total", "label": "样本数", "format": "number"}
  ],
  "categories": [
    {
      "id": "verified",
      "label": "原文核验入口",
      "dimensions": [
        {
          "id": "truthfulness",
          "label": "事实真实性评测",
          "intro": "使用官方问题与参考答案核验事实问答。",
          "benchmarks": [
            {
              "option_key": "truthfulqa",
              "name": "TruthfulQA",
              "url": "https://github.com/sylinrl/TruthfulQA",
              "language": "English",
              "scale": "790",
              "evaluation": "Best-answer accuracy",
              "intro": "TruthfulQA 使用 790 个容易诱发常见误解的问题，当前入口显示官方问题、最佳正确答案、其他正确答案、错误答案与证据来源。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/truthfulqa.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "TruthfulQA", "--dimension-label": "易谬误问题事实性检测", "--benchmark-url": "https://github.com/sylinrl/TruthfulQA", "--max-cases": 20}}
            }
          ]
        },
        {
          "id": "reasoning",
          "label": "证据与科学推理评测",
          "intro": "使用官方多跳证据问答和科学推理分片。",
          "benchmarks": [
            {
              "option_key": "hotpotqa",
              "name": "HotpotQA",
              "url": "https://hotpotqa.github.io/",
              "language": "English",
              "scale": "7,405 validation",
              "evaluation": "Answer accuracy",
              "intro": "HotpotQA 要求结合多个维基百科段落完成多跳问答；当前入口保留完整干扰段落、问题、答案、难度和支持事实。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/hotpotqa.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "HotpotQA", "--dimension-label": "多跳证据推理评测", "--benchmark-url": "https://hotpotqa.github.io/", "--max-cases": 20}}
            },
            {
              "option_key": "arc_challenge",
              "name": "ARC-Challenge",
              "url": "https://allenai.org/data/arc",
              "language": "English",
              "scale": "299 validation",
              "evaluation": "Multiple-choice accuracy",
              "intro": "ARC-Challenge 是 AI2 Reasoning Challenge 的高难度科学考试题分片，当前入口保留官方题干、选项和答案键。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/arc_challenge.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "ARC-Challenge", "--dimension-label": "高难科学知识准确性评测", "--benchmark-url": "https://allenai.org/data/arc", "--max-cases": 20}}
            }
          ]
        },
        {
          "id": "task_following",
          "label": "任务遵循评测",
          "intro": "使用官方约束遵循、科学问答和编程任务分片。",
          "benchmarks": [
            {
              "option_key": "followbench",
              "name": "FollowBench",
              "url": "https://aclanthology.org/2024.acl-long.257/",
              "language": "English, Chinese",
              "scale": "1,610 constrained prompts",
              "evaluation": "Official HSR/SSR/CSL; response collection locally",
              "intro": "FollowBench 逐级增加内容、情境、风格、格式和示例约束。当前入口保留中英文完整指令；由于开放式任务无唯一文本答案，界面明确标注官方 HSR、SSR、CSL 评法，不用占位模板做精确匹配。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/followbench.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "FollowBench", "--dimension-label": "细粒度约束遵循评测", "--benchmark-url": "https://aclanthology.org/2024.acl-long.257/", "--max-cases": 20}}
            },
            {
              "option_key": "arc_easy",
              "name": "ARC-Easy",
              "url": "https://allenai.org/data/arc",
              "language": "English",
              "scale": "570 validation",
              "evaluation": "Multiple-choice accuracy",
              "intro": "ARC-Easy 是 AI2 Reasoning Challenge 的基础科学问答分片，和高难度 ARC-Challenge 分开统计，避免两个入口重复运行同一数据。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/arc_easy.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "ARC-Easy", "--dimension-label": "基础科学知识准确性评测", "--benchmark-url": "https://allenai.org/data/arc", "--max-cases": 20}}
            },
            {
              "option_key": "apps_intro_interview",
              "name": "APPS-Introductory-Interview",
              "url": "https://github.com/hendrycks/apps",
              "language": "English",
              "scale": "3,455 test",
              "evaluation": "Execution tests or reference-code proxy",
              "intro": "APPS-Introductory-Interview 接入 APPS 测试集中的入门与面试难度编程题，展示完整题目、输入输出规范、测试和参考实现。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/apps_intro_interview.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "APPS-Introductory-Interview", "--dimension-label": "代码生成综合任务", "--benchmark-url": "https://github.com/hendrycks/apps", "--max-cases": 20}}
            },
            {
              "option_key": "apps_competition",
              "name": "APPS-Competition",
              "url": "https://github.com/hendrycks/apps",
              "language": "English",
              "scale": "310 test",
              "evaluation": "Execution tests or reference-code proxy",
              "intro": "APPS-Competition 单独接入竞赛难度编程题，使原有两个 APPS 入口变成难度互斥的可解释分片。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/apps_competition.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "APPS-Competition", "--dimension-label": "代码生成综合任务", "--benchmark-url": "https://github.com/hendrycks/apps", "--max-cases": 20}}
            }
          ]
        },
        {
          "id": "output_safety",
          "label": "内容安全与高风险知识评测",
          "intro": "判定既有回复是否符合安全伦理，或观察高风险知识的保留与暴露情况。",
          "benchmarks": [
            {
              "option_key": "diasafety",
              "name": "DiaSafety",
              "url": "https://aclanthology.org/2022.findings-acl.308/",
              "language": "English",
              "scale": "1,095 test",
              "evaluation": "Safe/unsafe classification accuracy",
              "intro": "DiaSafety 评估给定对话上下文时回复是否安全，重点是上下文敏感的不安全输出；当前入口把上下文和待判定回复完整组合为安全二分类题。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/diasafety.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "DiaSafety", "--dimension-label": "上下文对话安全伦理判断评测", "--benchmark-url": "https://aclanthology.org/2022.findings-acl.308/", "--max-cases": 20}}
            },
            {
              "option_key": "wmdp_biochem",
              "name": "WMDP-BioChem",
              "url": "https://www.wmdp.ai/",
              "language": "English",
              "scale": "1,681",
              "evaluation": "Multiple-choice accuracy",
              "intro": "WMDP-BioChem 合并生物安全与化学安全危险知识分片，测量模型对可被滥用的高风险专业知识的掌握程度。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/wmdp_biochem.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "WMDP-BioChem", "--dimension-label": "高风险知识滥用抵御评测", "--benchmark-url": "https://www.wmdp.ai/", "--max-cases": 20}}
            }
          ]
        },
        {
          "id": "attack_robustness",
          "label": "对抗攻击评测",
          "intro": "仅接入含显式攻击变换、越狱模板或多轮攻击结构的提示。",
          "benchmarks": [
            {
              "option_key": "cosafe",
              "name": "CoSafe",
              "url": "https://aclanthology.org/2024.emnlp-main.968/",
              "language": "English",
              "scale": "1,400",
              "evaluation": "Refusal proxy; official attack success evaluation",
              "intro": "CoSafe 用 14 类多轮共指对话隐藏不安全目标。当前入口保留每轮用户和助手消息，并以安全拒答代理检查最后一轮攻击是否绕过策略。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/cosafe.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "CoSafe", "--dimension-label": "多轮共指攻击防御评测", "--benchmark-url": "https://aclanthology.org/2024.emnlp-main.968/", "--max-cases": 20}}
            },
            {
              "option_key": "gptfuzzer",
              "name": "GPTFuzzer",
              "url": "https://github.com/sherdencooper/GPTFuzz",
              "language": "English",
              "scale": "77 templates paired with harmful goals",
              "evaluation": "Refusal proxy",
              "intro": "GPTFuzzer 当前将官方自动生成的越狱模板与官方有害问题表组合，修复了此前误把响应标签数字当题目的问题。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/gptfuzzer.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "GPTFuzzer", "--dimension-label": "自动变异越狱防御评测", "--benchmark-url": "https://github.com/sherdencooper/GPTFuzz", "--max-cases": 20}}
            },
            {
              "option_key": "latent_jailbreak",
              "name": "LatentJailbreak",
              "url": "https://github.com/qiuhuachuan/latent-jailbreak",
              "language": "English",
              "scale": "2,424 prompts",
              "evaluation": "Refusal proxy",
              "intro": "LatentJailbreak 使用任务外壳包裹有毒生成目标，测试模型是否优先完成表层任务而隐式输出不安全文本；入口改为官方 prompt 模板文件。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/latent_jailbreak.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "LatentJailbreak", "--dimension-label": "潜在任务越狱防御评测", "--benchmark-url": "https://github.com/qiuhuachuan/latent-jailbreak", "--max-cases": 20}}
            },
            {
              "option_key": "doanythingnow",
              "name": "DoAnythingNow",
              "url": "https://github.com/verazuo/jailbreak_llms",
              "language": "English",
              "scale": "1,405 jailbreak prompts",
              "evaluation": "Refusal proxy",
              "intro": "DoAnythingNow 使用从真实平台收集的 1,405 条越狱提示，并与官方 390 条禁止问题集配对，测试野外越狱模板的绕过能力。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/doanythingnow.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "DoAnythingNow", "--dimension-label": "野外越狱提示防御评测", "--benchmark-url": "https://github.com/verazuo/jailbreak_llms", "--max-cases": 20}}
            },
            {
              "option_key": "xsafety_attack_defense",
              "name": "XSafety-Attack-Defense",
              "url": "https://github.com/Jarviswang94/Multilingual_safety_benchmark",
              "language": "10 languages",
              "scale": "2,000 goal-hijacking prompts",
              "evaluation": "Attack refusal accuracy by language",
              "intro": "XSafety-Attack-Defense 只接入 10 种语言的 Goal Hijacking 类，共 2,000 条包含忽略前序指令、劫持目标或强制输出的显式攻击提示，用于评估多语种目标劫持防御。",
              "paths": {"dataset": "benchmarks/custom_privacy/xsafety_attack_refusal.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "XSafety-Attack-Defense", "--dimension-label": "多语种越狱提示攻击防御评测", "--benchmark-url": "https://github.com/Jarviswang94/Multilingual_safety_benchmark", "--max-cases": 20}}
            },
            {
              "option_key": "saladbench_attack",
              "name": "SaladBench",
              "url": "https://github.com/OpenSafetyLab/SALAD-BENCH",
              "language": "English",
              "scale": "5,000 attack-enhanced prompts",
              "evaluation": "Official safety judge required",
              "intro": "SaladBench 当前固定使用官方 attack_enhanced_set，而不是此前误选的安全答案选择题；界面展示基础问题、完整攻击改写、攻击方法和三级风险标签。",
              "paths": {"dataset": "benchmarks/verified_benchmarks/data/saladbench_attack.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "SaladBench", "--dimension-label": "对抗改写攻击防御评测", "--benchmark-url": "https://github.com/OpenSafetyLab/SALAD-BENCH", "--max-cases": 20}}
            }
          ]
        },
        {
          "id": "system_policy",
          "label": "风险请求抵御评测",
          "intro": "使用普通有害请求、行为集合或显式访问规则，分别评估风险请求抵御和机密信息保护。",
          "benchmarks": [
