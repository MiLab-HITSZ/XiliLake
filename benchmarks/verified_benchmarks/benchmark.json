              "paths": {"dataset": "benchmarks/trusted_downloaded_harmful_capability/rules_confidentiality.jsonl", "results": "result"},
              "execution": {"extra_args": {"--benchmark-name": "RuLES", "--dimension-label": "机密信息授权访问控制评测", "--benchmark-url": "https://github.com/normster/llm_rules", "--max-cases": 20}}
            },
            {
              "option_key": "xsafety_multilingual",
              "name": "XSafety",
              "url": "https://github.com/Jarviswang94/Multilingual_safety_benchmark",
              "language": "10 languages",
              "scale": "17,990 policy prompts",
              "evaluation": "Refusal accuracy by language and risk category",
              "intro": "XSafety 有害请求抵御入口使用 10 种语言、9 类普通风险请求的 17,990 条本地拒答视图。Privacy And Property 转入用户隐私安全性，Goal Hijacking 用于越狱攻击防御；标签与内容不稳定的 Prompt Leaking 和 Role Play Instruction 不参与评分。各分片互不重复。",
              "paths": {"dataset": "benchmarks/custom_privacy/xsafety_multilingual_refusal.jsonl", "results": "result"},
