{
  "id": "custom_fairness",
  "label": "公平性与偏见",
  "benchmark_name": "公平性补充评测",
  "description": "基于已下载 CrowS-Pairs 与 CDialBias 数据整理的可评分公平性补充评测，用于补齐刻板印象识别和中文对话偏见问答。",
  "source_type": "custom_curated",
  "enabled": true,
  "paths": {
    "results": "result"
  },
  "execution": {
    "adapter": "python_cli",
    "script": "evaluate_generic_benchmark.py",
    "default_tasks": [
      "qa"
    ],
    "supported_tasks": [
      "qa",
      "mc"
    ],
    "supports_real_eval": true
  },
  "display": {
    "mode": "generic_text_qa",
    "sections": [
      "selection_detail",
      "progress",
      "summary",
      "metrics"
    ]
  },
  "metrics": [
    {
      "key": "accuracy",
      "label": "准确率",
      "format": "percent"
    },
    {
      "key": "response_rate",
      "label": "响应率",
      "format": "percent"
    },
    {
      "key": "avg_latency_ms",
      "label": "平均延迟 ms",
      "format": "number"
    },
    {
      "key": "n_total",
      "label": "样本数",
      "format": "number"
    }
  ],
  "categories": [
    {
      "id": "fairness_bias",
      "label": "社会群体公平性",
      "dimensions": [
        {
          "id": "stereotype_pair_detection",
          "label": "刻板印象成对识别",
          "name_en": "Stereotype Pair Detection",
          "intro": "评估模型在成对句子中识别更具刻板印象或偏见表达的能力。",
          "benchmarks": [
            {
              "option_key": "crows_pairs_stereotype_mc",
              "name": "CrowS-Pairs-Stereotype-MC",
              "intro": "基于已下载 CrowS-Pairs 数据整理为二选一选择题，考察模型能否识别更具刻板印象的句子。",
              "url": "https://github.com/nyu-mll/crows-pairs",
              "language": "English",
              "scale": "120",
              "evaluation": "Accuracy",
              "paths": {
                "dataset": "benchmarks/custom_fairness/crows_pairs_stereotype_mc.jsonl",
                "results": "result"
              },
              "display": {
                "mode": "generic_text_qa",
                "sections": [
                  "selection_detail",
                  "progress",
                  "summary",
                  "metrics"
                ],
                "case_view": "text_sample"
              },
              "execution": {
                "adapter": "python_cli",
                "script": "evaluate_generic_benchmark.py",
                "default_tasks": [
                  "mc"
                ],
                "supported_tasks": [
                  "mc"
                ],
                "supports_real_eval": true,
                "args": {
                  "dataset": "--dataset",
                  "output_dir": "--output-dir",
                  "models": "--models",
                  "tasks": "--tasks",
                  "parallel": "--parallel",
                  "retry": "--retry",
                  "timeout_s": "--timeout-s",
                  "progress_file": "--progress-file",
                  "categories": "--categories",
                  "dimensions": "--dimensions"
                },
                "extra_args": {
                  "--benchmark-name": "CrowS-Pairs-Stereotype-MC",
                  "--dimension-label": "刻板印象成对识别",
                  "--benchmark-url": "https://github.com/nyu-mll/crows-pairs",
                  "--max-cases": 20
                }
              }
            }
          ]
        },
        {
          "id": "chinese_dialogue_bias_qa",
          "label": "中文对话偏见问答",
          "name_en": "Chinese Dialogue Bias QA",
          "intro": "评估模型在中文社会身份与偏见语境下的问答稳定性和偏见处理能力。",
          "benchmarks": [
            {
              "option_key": "cdial_bias_qa",
              "name": "CDialBias-QA",
              "intro": "基于已下载 CDialBias 测试集整理为问答格式，用于中文对话偏见场景下的答案一致性评测。",
              "url": "https://huggingface.co/datasets/para-zhou/CDial-Bias",
              "language": "Chinese",
              "scale": "120",
              "evaluation": "Accuracy",
              "paths": {
                "dataset": "benchmarks/custom_fairness/cdial_bias_qa.jsonl",
                "results": "result"
              },
              "display": {
                "mode": "generic_text_qa",
                "sections": [
                  "selection_detail",
                  "progress",
                  "summary",
                  "metrics"
                ],
                "case_view": "text_sample"
              },
              "execution": {
                "adapter": "python_cli",
                "script": "evaluate_generic_benchmark.py",
                "default_tasks": [
                  "qa"
                ],
                "supported_tasks": [
                  "qa"
                ],
                "supports_real_eval": true,
                "args": {
                  "dataset": "--dataset",
                  "output_dir": "--output-dir",
                  "models": "--models",
                  "tasks": "--tasks",
                  "parallel": "--parallel",
                  "retry": "--retry",
                  "timeout_s": "--timeout-s",
                  "progress_file": "--progress-file",
                  "categories": "--categories",
                  "dimensions": "--dimensions"
                },
                "extra_args": {
                  "--benchmark-name": "CDialBias-QA",
                  "--dimension-label": "中文对话偏见问答",
                  "--benchmark-url": "https://huggingface.co/datasets/para-zhou/CDial-Bias",
                  "--max-cases": 20
                }
              }
            }
          ]
        }
      ]
    }
  ]
