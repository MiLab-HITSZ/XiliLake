{
  "id": "custom_privacy",
  "label": "隐私与数据安全",
  "benchmark_name": "隐私拒答评测",
  "description": "基于已下载 XSafety 隐私与财产子集整理的隐私泄露拒答评测入口，用于检查模型面对个人信息、凭据、财产隐私等请求时是否拒绝泄露或协助滥用。",
  "source_type": "custom_curated",
  "enabled": true,
  "paths": {
    "results": "result"
  },
  "execution": {
    "adapter": "python_cli",
    "script": "evaluate_generic_benchmark.py",
    "default_tasks": [
      "qa"
    ],
    "supported_tasks": [
      "qa"
    ],
    "supports_real_eval": true
  },
  "display": {
    "mode": "generic_text_qa",
    "sections": [
      "selection_detail",
      "progress",
      "summary",
      "metrics"
    ]
  },
  "metrics": [
    {
      "key": "accuracy",
      "label": "拒答正确率",
      "format": "percent"
    },
    {
      "key": "response_rate",
      "label": "响应率",
      "format": "percent"
    },
    {
      "key": "avg_latency_ms",
      "label": "平均延迟 ms",
      "format": "number"
    },
    {
      "key": "n_total",
      "label": "样本数",
      "format": "number"
    }
  ],
  "categories": [
    {
      "id": "privacy_security",
      "label": "隐私、数据与系统安全",
      "dimensions": [
        {
          "id": "privacy_refusal",
          "label": "个人信息与财产侵害请求拒答评测",
          "name_en": "Privacy and Property Request Protection",
          "intro": "题目直接向模型索取个人资料、账号或支付凭据，或者要求协助实施财产侵害，模型应识别风险并拒绝提供可执行帮助。当前使用 XSafety 全部 10 种语言的 2,000 条 Privacy And Property 请求，统一以安全拒答为参考行为；该分片与非隐私风险入口互不重叠，也不涉及显式授权规则。",
          "benchmarks": [
            {
              "option_key": "xsafety_privacy_refusal",
              "name": "XSafety-Privacy-Refusal",
              "intro": "XSafety-Privacy-Refusal 固定使用 XSafety 全部 10 种语言的 Privacy And Property 类共 2,000 条样本。请求覆盖个人资料泄露、账号或密码获取、支付凭据滥用和其他财产侵害协助；每条样本的 gold 均为 SAFE_REFUSAL。系统检查模型是否明确拒绝且没有继续给出可执行细节，并统计拒答正确率、响应率和延迟。该分片已从普通有害请求版 XSafety 中排除，不会重复计数。",
              "url": "https://github.com/Jarviswang94/Multilingual_safety_benchmark",
              "language": "10 languages",
              "scale": "2,000",
              "evaluation": "Refusal Accuracy",
              "example": {},
              "metrics": [
                {
                  "key": "accuracy",
                  "label": "拒答正确率",
                  "format": "percent"
                },
                {
                  "key": "response_rate",
                  "label": "响应率",
                  "format": "percent"
                },
                {
                  "key": "avg_latency_ms",
                  "label": "平均延迟 ms",
                  "format": "number"
                },
                {
                  "key": "n_total",
                  "label": "样本数",
                  "format": "number"
                }
              ],
              "paths": {
                "dataset": "benchmarks/custom_privacy/xsafety_privacy_refusal.jsonl",
                "results": "result"
              },
              "display": {
                "mode": "generic_text_qa",
                "sections": [
                  "selection_detail",
                  "progress",
                  "summary",
                  "metrics"
                ],
                "case_view": "text_sample"
              },
              "execution": {
                "adapter": "python_cli",
                "script": "evaluate_generic_benchmark.py",
                "default_tasks": [
                  "qa"
                ],
                "supported_tasks": [
                  "qa"
                ],
                "supports_real_eval": true,
                "args": {
                  "dataset": "--dataset",
                  "output_dir": "--output-dir",
                  "models": "--models",
                  "tasks": "--tasks",
                  "parallel": "--parallel",
                  "retry": "--retry",
                  "timeout_s": "--timeout-s",
                  "progress_file": "--progress-file",
                  "categories": "--categories",
                  "dimensions": "--dimensions"
                },
                "extra_args": {
                  "--benchmark-name": "XSafety-Privacy-Refusal",
                  "--dimension-label": "个人信息与财产侵害请求拒答评测",
                  "--benchmark-url": "https://github.com/Jarviswang94/Multilingual_safety_benchmark",
                  "--max-cases": 20
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
