{
  "id": "custom_privacy",
  "label": "隐私与数据安全",
  "benchmark_name": "隐私拒答评测",
  "description": "基于已下载 XSafety 隐私与财产子集整理的隐私泄露拒答评测入口，用于检查模型面对个人信息、凭据、财产隐私等请求时是否拒绝泄露或协助滥用。",
  "source_type": "custom_curated",
  "enabled": true,
  "paths": {
    "results": "result"
  },
  "execution": {
    "adapter": "python_cli",
    "script": "evaluate_generic_benchmark.py",
    "default_tasks": [
      "qa"
    ],
    "supported_tasks": [
      "qa"
    ],
    "supports_real_eval": true
  },
  "display": {
    "mode": "generic_text_qa",
    "sections": [
      "selection_detail",
      "progress",
      "summary",
      "metrics"
    ]
  },
  "metrics": [
    {
      "key": "accuracy",
      "label": "拒答正确率",
      "format": "percent"
    },
    {
      "key": "response_rate",
      "label": "响应率",
      "format": "percent"
    },
    {
      "key": "avg_latency_ms",
      "label": "平均延迟 ms",
      "format": "number"
    },
    {
      "key": "n_total",
      "label": "样本数",
      "format": "number"
    }
  ],
  "categories": [
    {
      "id": "privacy_security",
      "label": "隐私信息安全性",
      "dimensions": [
        {
          "id": "privacy_refusal",
          "label": "财产隐私安全性评测",
          "name_en": "Privacy and Property Request Protection",
          "intro": "使用 XSafety-Privacy-Refusal 构建财产隐私安全性评测子类，仅包含 Privacy And Property 类的个人资料泄露、账号或支付凭据获取，以及财产侵害请求。数据覆盖 10 种语言、共 2,000 条样本，每条样本以安全拒答为参考行为。",
          "benchmarks": [
            {
              "option_key": "xsafety_privacy_refusal",
              "name": "XSafety-Privacy-Refusal",
              "intro": "XSafety-Privacy-Refusal 使用 XSafety 全部 10 种语言的 Privacy And Property 类共 2,000 条样本，仅包含个人资料泄露、账号或密码获取、支付凭据滥用和其他财产侵害请求。每条样本的 gold 均为 SAFE_REFUSAL，系统统计拒答正确率、响应率和平均延迟。",
              "url": "https://github.com/Jarviswang94/Multilingual_safety_benchmark",
              "language": "10 languages",
              "scale": "2,000",
              "evaluation": "Refusal Accuracy",
              "example": {},
              "metrics": [
                {
                  "key": "accuracy",
                  "label": "拒答正确率",
                  "format": "percent"
                },
                {
                  "key": "response_rate",
                  "label": "响应率",
                  "format": "percent"
                },
                {
                  "key": "avg_latency_ms",
                  "label": "平均延迟 ms",
                  "format": "number"
                },
                {
                  "key": "n_total",
                  "label": "样本数",
                  "format": "number"
                }
              ],
              "paths": {
                "dataset": "benchmarks/custom_privacy/xsafety_privacy_refusal.jsonl",
                "results": "result"
              },
              "display": {
                "mode": "generic_text_qa",
                "sections": [
                  "selection_detail",
                  "progress",
                  "summary",
                  "metrics"
                ],
                "case_view": "text_sample"
              },
              "execution": {
                "adapter": "python_cli",
                "script": "evaluate_generic_benchmark.py",
                "default_tasks": [
                  "qa"
                ],
                "supported_tasks": [
                  "qa"
                ],
                "supports_real_eval": true,
                "args": {
                  "dataset": "--dataset",
                  "output_dir": "--output-dir",
                  "models": "--models",
                  "tasks": "--tasks",
                  "parallel": "--parallel",
                  "retry": "--retry",
                  "timeout_s": "--timeout-s",
                  "progress_file": "--progress-file",
                  "categories": "--categories",
                  "dimensions": "--dimensions"
                },
                "extra_args": {
                  "--benchmark-name": "XSafety-Privacy-Refusal",
                  "--dimension-label": "财产隐私安全性评测",
                  "--benchmark-url": "https://github.com/Jarviswang94/Multilingual_safety_benchmark",
                  "--max-cases": 20
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
